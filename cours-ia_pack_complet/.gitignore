# ============================================================
#  .gitignore  --  a placer a la RACINE du depot ia-parcours
#  Ce qui est liste ici ne sera JAMAIS envoye sur GitHub.
# ============================================================

# --- Environnements virtuels (a recreer, jamais a partager) ---
.venv/
venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Secrets : JAMAIS dans Git (voir SETUP/venv_et_env_expliques.md) ---
.env
.env.*
!.env.example
*.key
secrets.json
credentials.json

# --- Modeles entraines et donnees volumineuses (regenerables) ---
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.onnx
*.parquet
data/processed/
data/interim/

# --- Editeurs et systeme ---
.vscode/*
!.vscode/settings.json
.idea/
Thumbs.db
desktop.ini
.DS_Store
