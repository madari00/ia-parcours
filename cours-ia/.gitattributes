# Fins de ligne identiques partout (Windows, Mac, Linux)
# -> supprime les avertissements "LF will be replaced by CRLF"
* text=auto eol=lf

# Scripts Windows : gardent leurs fins de ligne CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Fichiers binaires : Git ne doit pas y toucher
*.docx binary
*.xlsx binary
*.pptx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
